<workout_file>
  <author>Rullo</author>
  <name>Ripartenza – 16. Fondo facile</name>
  <description>Settimana 6 di 8. Pedalata tranquilla in zona 2: devi poter parlare. Cadenza sciolta 85-95 rpm.</description>
  <sportType>bike</sportType>
  <workout>
    <Ramp Duration="300" PowerLow="0.40" PowerHigh="0.65"/>
    <SteadyState Duration="1800" Power="0.62"/>
    <Ramp Duration="300" PowerLow="0.60" PowerHigh="0.40"/>
  </workout>
</workout_file>
