<workout_file>
  <author>Rullo</author>
  <name>Alza l'FTP – 08. Soglia 3×8'</name>
  <description>Settimana 3 di 6. 3 × 8' al 98% FTP.</description>
  <sportType>bike</sportType>
  <workout>
    <Ramp Duration="480" PowerLow="0.40" PowerHigh="0.75"/>
    <SteadyState Duration="60" Power="0.95"/>
    <SteadyState Duration="180" Power="0.55"/>
    <IntervalsT Repeat="3" OnDuration="480" OffDuration="240" OnPower="0.98" OffPower="0.50"/>
    <Ramp Duration="300" PowerLow="0.60" PowerHigh="0.40"/>
  </workout>
</workout_file>
