<workout_file>
  <author>Rullo</author>
  <name>Alza l'FTP – 04. Sweet spot 3×10'</name>
  <description>Settimana 2 di 6. 3 × 10' al 90% FTP.</description>
  <sportType>bike</sportType>
  <workout>
    <Ramp Duration="480" PowerLow="0.40" PowerHigh="0.75"/>
    <SteadyState Duration="60" Power="0.95"/>
    <SteadyState Duration="180" Power="0.55"/>
    <IntervalsT Repeat="3" OnDuration="600" OffDuration="240" OnPower="0.90" OffPower="0.55"/>
    <Ramp Duration="300" PowerLow="0.60" PowerHigh="0.40"/>
  </workout>
</workout_file>
