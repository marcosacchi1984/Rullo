<workout_file>
  <author>Rullo</author>
  <name>Alza l'FTP – 13. Sweet spot 2×20'</name>
  <description>Settimana 5 di 6. 2 × 20' al 90% FTP: il più lungo del piano.</description>
  <sportType>bike</sportType>
  <workout>
    <Ramp Duration="480" PowerLow="0.40" PowerHigh="0.75"/>
    <SteadyState Duration="60" Power="0.95"/>
    <SteadyState Duration="180" Power="0.55"/>
    <IntervalsT Repeat="2" OnDuration="1200" OffDuration="300" OnPower="0.90" OffPower="0.55"/>
    <Ramp Duration="300" PowerLow="0.60" PowerHigh="0.40"/>
  </workout>
</workout_file>
