<workout_file>
  <author>Rullo</author>
  <name>Alza l'FTP – 10. Sweet spot leggero</name>
  <description>Settimana 4 di 6 (scarico). 3 × 8' all'85%: settimana di scarico.</description>
  <sportType>bike</sportType>
  <workout>
    <Ramp Duration="480" PowerLow="0.40" PowerHigh="0.75"/>
    <SteadyState Duration="60" Power="0.95"/>
    <SteadyState Duration="180" Power="0.55"/>
    <IntervalsT Repeat="3" OnDuration="480" OffDuration="240" OnPower="0.85" OffPower="0.55"/>
    <Ramp Duration="300" PowerLow="0.60" PowerHigh="0.40"/>
  </workout>
</workout_file>
