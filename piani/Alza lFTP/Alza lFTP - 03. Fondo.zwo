<workout_file>
  <author>Rullo</author>
  <name>Alza l'FTP – 03. Fondo</name>
  <description>Settimana 1 di 6. Fondo in zona 2 per recuperare e costruire resistenza.</description>
  <sportType>bike</sportType>
  <workout>
    <Ramp Duration="300" PowerLow="0.40" PowerHigh="0.65"/>
    <SteadyState Duration="3000" Power="0.65"/>
    <Ramp Duration="300" PowerLow="0.60" PowerHigh="0.40"/>
  </workout>
</workout_file>
