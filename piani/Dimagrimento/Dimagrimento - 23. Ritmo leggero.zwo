<workout_file>
  <author>Rullo</author>
  <name>Dimagrimento – 23. Ritmo leggero</name>
  <description>Settimana 8 di 10 (scarico). 4 × 4' all'80%: settimana di scarico. Lo sweet spot (85-90% FTP) è faticoso ma sostenibile: fa crescere l'FTP con poco tempo.</description>
  <sportType>bike</sportType>
  <workout>
    <Ramp Duration="480" PowerLow="0.40" PowerHigh="0.75"/>
    <SteadyState Duration="60" Power="0.95"/>
    <SteadyState Duration="180" Power="0.55"/>
    <IntervalsT Repeat="4" OnDuration="240" OffDuration="120" OnPower="0.80" OffPower="0.55"/>
    <SteadyState Duration="240" Power="0.60"/>
    <Ramp Duration="300" PowerLow="0.60" PowerHigh="0.40"/>
  </workout>
</workout_file>
