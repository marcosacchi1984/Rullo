<workout_file>
  <author>Rullo</author>
  <name>Dimagrimento – 05. Sweet spot 3×6'</name>
  <description>Settimana 2 di 10. 3 blocchi da 6' all'88% FTP. Lo sweet spot (85-90% FTP) è faticoso ma sostenibile: fa crescere l'FTP con poco tempo.</description>
  <sportType>bike</sportType>
  <workout>
    <Ramp Duration="480" PowerLow="0.40" PowerHigh="0.75"/>
    <SteadyState Duration="60" Power="0.95"/>
    <SteadyState Duration="180" Power="0.55"/>
    <IntervalsT Repeat="3" OnDuration="360" OffDuration="180" OnPower="0.88" OffPower="0.55"/>
    <SteadyState Duration="60" Power="0.60"/>
    <Ramp Duration="300" PowerLow="0.60" PowerHigh="0.40"/>
  </workout>
</workout_file>
