<workout_file>
  <author>Rullo</author>
  <name>Dimagrimento – 15. Fondo lungo</name>
  <description>Settimana 5 di 10. L'uscita lunga in zona 2, ogni tanto un allungo di cadenza. Porta acqua: con il rullo si suda molto più che su strada.</description>
  <sportType>bike</sportType>
  <workout>
    <Ramp Duration="300" PowerLow="0.40" PowerHigh="0.65"/>
    <SteadyState Duration="945" Power="0.64"/>
    <SteadyState Duration="30" Power="0.75"/>
    <SteadyState Duration="945" Power="0.64"/>
    <SteadyState Duration="30" Power="0.75"/>
    <SteadyState Duration="945" Power="0.64"/>
    <SteadyState Duration="30" Power="0.75"/>
    <SteadyState Duration="945" Power="0.64"/>
    <SteadyState Duration="30" Power="0.75"/>
    <Ramp Duration="300" PowerLow="0.60" PowerHigh="0.40"/>
  </workout>
</workout_file>
