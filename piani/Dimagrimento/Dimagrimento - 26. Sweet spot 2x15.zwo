<workout_file>
  <author>Rullo</author>
  <name>Dimagrimento – 26. Sweet spot 2×15'</name>
  <description>Settimana 9 di 10. 2 blocchi da 15' all'88% FTP. Lo sweet spot (85-90% FTP) è faticoso ma sostenibile: fa crescere l'FTP con poco tempo.</description>
  <sportType>bike</sportType>
  <workout>
    <Ramp Duration="480" PowerLow="0.40" PowerHigh="0.75"/>
    <SteadyState Duration="60" Power="0.95"/>
    <SteadyState Duration="180" Power="0.55"/>
    <IntervalsT Repeat="2" OnDuration="900" OffDuration="300" OnPower="0.88" OffPower="0.55"/>
    <Ramp Duration="300" PowerLow="0.60" PowerHigh="0.40"/>
  </workout>
</workout_file>
